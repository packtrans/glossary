{
  "name": "packtrans-glossary",
  "private": true,
  "scripts": {
    "build": "pnpm --filter packtrans-glossary-web run build",
    "deploy": "pnpm --filter packtrans-glossary-web run deploy"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.0.0",
      "onFail": "download"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
      "vitest": "4.1.9"
    }
  }
}
